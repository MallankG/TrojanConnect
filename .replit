modules = ["nodejs-20", "python-3.12"]

# Chromium for the RSO portal agent. Playwright's own browser download needs system libraries
# Replit doesn't have (its bundled Node fails on libatomic.so.1), so the agent uses this one.
[nix]
packages = ["chromium"]

# Workspace "Run" button: backend + Next.js dev server.
run = "bash scripts/replit.sh dev"

[deployment]
# Reserved VM: the planning assistant, RSO tracker, Slack previews and delivery dedupe keep state in
# one process and its disk; several autoscaled copies would split it.
deploymentTarget = "vm"
build = ["bash", "scripts/replit.sh", "build"]
run = ["bash", "scripts/replit.sh", "start"]

# One public port: Next.js. It forwards /api/* and /mock-engagesc/* to FastAPI on 127.0.0.1:8000.
[[ports]]
localPort = 3000
externalPort = 80
