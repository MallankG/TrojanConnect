# Copy to backend/.env and fill in. Everything is optional for local dev:
# empty Supabase keys -> in-memory demo data; empty Gemini key -> rule-based fallback agent.
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
ALLOW_DEMO_AUTH=true

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_DECISION_MODEL=gemini-decision-1
GEMINI_API_VERSION=v1beta

# Messaging channel (WhatsApp or alternative, e.g. Telegram) - not used yet
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
TELEGRAM_BOT_TOKEN=

# In-memory seed dataset: auto (real if collected data present, else demo) | real | demo
SEED_DATASET=auto
