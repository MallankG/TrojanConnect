# Event agent (Assistant tab). Run the backend with: .venv/bin/uvicorn main:app --port 8000 --env-file .env
# Assistant: "rules" = built-in rule-based Club Agent, no Gemini calls. Remove (or set to "gemini") to use Gemini;
# if Gemini fails (e.g. quota) the chat falls back to the rule-based agent automatically.
ASSISTANT_MODE=rules
# Demo only: a simulated venue / permits office approves accepted requests (labelled simulated).
# false = a person approves on /venue-review.
DEMO_AUTO_REVIEW=false
GEMINI_API_KEY=
# Optional: pin the chat model (default gemini-3.5-flash) and the API version (e.g. v1beta).
GEMINI_CHAT_MODEL=
GEMINI_API_VERSION=
# Browser origins allowed to call the API, comma-separated. Default: http://localhost:3000
FRONTEND_ORIGIN=
