# Event agent (Assistant tab). Run the backend with: .venv/bin/uvicorn main:app --port 8000 --env-file .env
GEMINI_API_KEY=
# Optional: pin the chat model (default gemini-3.5-flash) and the API version (e.g. v1beta).
GEMINI_CHAT_MODEL=
GEMINI_API_VERSION=
# Browser origins allowed to call the API, comma-separated. Default: http://localhost:3000
FRONTEND_ORIGIN=
