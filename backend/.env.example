# Copy to backend/.env and fill in. Everything is optional for local dev:
# empty Supabase keys -> in-memory demo data; empty Gemini key -> rule-based fallback agent.
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
ALLOW_DEMO_AUTH=true

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Event planning assistant (Assistant tab, /api/v1/pipeline/agent/chat). Start the backend with --env-file .env.
# rules = built-in rule-based Club Agent, no Gemini calls; gemini = Gemini, falling back to the built-in agent if it fails.
ASSISTANT_MODE=rules
# Demo only: a simulated venue / permits office approves accepted bookings (labelled simulated). false = a person approves on /venue-review.
DEMO_AUTO_REVIEW=false
# Where venue bookings are stored: auto (Supabase when configured and supabase/migrations/0004_venue_booking.sql is applied,
# otherwise backend/data/bookings.json) | supabase | json
BOOKING_STORE=auto
# Who supplies availability and places confirmed bookings: simulated (today). An admin-agent adapter can be registered later.
BOOKING_ADAPTER=simulated
# RSO portal agent: "mock" serves the simulated EngageSC at /mock-engagesc and lets the agent submit there (demo data); "off" disables it.
RSO_PORTAL=mock
RSO_PORTAL_BASE_URL=http://localhost:8000/mock-engagesc
# true opens a visible Chrome window while the portal agent works (good for demos); default is headless.
RSO_PORTAL_SHOW_BROWSER=false

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_DECISION_MODEL=gemini-decision-1
GEMINI_API_VERSION=v1beta

# Embeddings: gemini or local Ollama. nomic-embed-text returns 768 dimensions.
EMBEDDING_PROVIDER=gemini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Slack bot (see README "Slack bot"). Empty = the /api/v1/webhooks/slack endpoint refuses requests.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_OUTREACH_CHANNEL=
# Verified Slack user -> TrojanConnect identity. Possession of a Slack account is not club authority:
# roles still come from the server (app/security/demo_roles.py).
SLACK_USER_MAP=
APP_BASE_URL=http://localhost:3000

# In-memory seed dataset: auto (real if collected data present, else demo) | real | demo
SEED_DATASET=auto
